<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.schuanhe.Plook.mapper.RoomMapper">

    <resultMap id="roomChatMap" type="RoomChat">
        <id property="id" column="id"/>
        <result property="roomId" column="room_id"/>
        <result property="time" column="time"/>
        <result property="data" column="chat"/>
        <result property="userId" column="user_id"/>
    </resultMap>

    <resultMap id="roomAndChats" type="Room">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="admin" column="admin"/>
        <collection property="roomChats" column="id" select="getChatsByRoomId"/>
    </resultMap>

    <insert id="addRoomChat" parameterType="RoomChat">
        INSERT INTO room_chat (chat, room_id, time, user_id)
        VALUES (#{data}, #{roomId}, #{time}, #{userId})
    </insert>

    <select id="getRoomAndChatsById" resultMap="roomAndChats">
        SELECT id, name, admin
        FROM room
        WHERE id = #{id}
    </select>

    <select id="getChatsByRoomId" resultMap="roomChatMap">
        SELECT id, chat, room_id, time, user_id
        FROM room_chat
        WHERE room_id = #{id}
        ORDER BY time ASC, id ASC
    </select>
</mapper>
